# ==================== APP ====================
NODE_ENV=development                          # development | staging | production
APP_NAME="Teras Lmbur OS"
APP_URL=http://localhost:3000

# ==================== API ====================
API_PORT=3001
API_URL=http://localhost:3001
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# ==================== DATABASE ====================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teras_lmbur_dev
# DATABASE_URL_STAGING=                       # Neon staging
# DATABASE_URL_PRODUCTION=                    # Neon production

# ==================== REDIS ====================
REDIS_URL=redis://localhost:6379
# REDIS_URL_PRODUCTION=                       # Upstash

# ==================== AUTH ====================
JWT_SECRET=change-this-to-a-secure-secret-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-another-secure-secret-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ==================== FEATURES ====================
ENABLE_MULTI_OUTLET=false
DEFAULT_CURRENCY=EGP
DEFAULT_TIMEZONE=Africa/Cairo
